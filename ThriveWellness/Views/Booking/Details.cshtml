@model ThriveWellness.Models.BookingSubmitViewModel

@{
    ViewData["Title"] = "Confirm Your Booking";
    ViewData["ThriveBodyBeige"] = true;
}

<section class="thrive-container thrive-booking-page">
    <div class="thrive-booking-card">
        <div class="thrive-booking-card__header">
            @if (Model.IsNewClient)
            {
                <h1 class="thrive-h2-serif-italic">Welcome to Thrive Pilates</h1>
                <span class="thrive-subtitle-italic">Before your first class, please complete the form below.</span>
            }
            else
            {
                <h1 class="thrive-h2-serif-italic">Welcome back</h1>
                <span class="thrive-subtitle-italic">We've pre-filled your details from your last booking.</span>
            }
        </div>

        <p class="thrive-text-muted">
            @Model.SessionType.ToDisplayLabel() at @Model.LocationName on @Model.SessionDate.ToString("dddd d MMMM yyyy") at @Model.SessionTime.ToString(@"hh\:mm")
        </p>

        <div asp-validation-summary="All" class="thrive-validation-summary"></div>

        <form asp-controller="Booking" asp-action="Submit" method="post" data-busy-text="Confirming…">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SessionId" />
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="IsNewClient" />
            <input type="hidden" asp-for="SessionType" />
            <input type="hidden" asp-for="SessionDate" />
            <input type="hidden" asp-for="SessionTime" />
            <input type="hidden" asp-for="LocationName" />

            <div class="thrive-field">
                @* Plain label/id here, not asp-for: the hidden asp-for="Email"
                   input above already owns id="Email" and carries the real
                   submitted value - this input is just a read-only display. *@
                <label class="thrive-label" for="EmailDisplay">Email</label>
                <input id="EmailDisplay" class="thrive-input" value="@Model.Email" readonly />
            </div>

            @if (Model.IsNewClient)
            {
                <div class="thrive-field">
                    <label class="thrive-label" asp-for="FullName"></label>
                    <input asp-for="FullName" class="thrive-input" placeholder="e.g. Jessica Miller" />
                    <span asp-validation-for="FullName" class="thrive-field-error"></span>
                </div>

                <div class="thrive-field">
                    <label class="thrive-label" asp-for="PhoneNumber"></label>
                    <input asp-for="PhoneNumber" class="thrive-input" placeholder="e.g. +27 92 359 2376" />
                    <span asp-validation-for="PhoneNumber" class="thrive-field-error"></span>
                </div>

                <div class="thrive-field">
                    <label class="thrive-label" asp-for="MedicalNotes">Medical Conditions or Injuries</label>
                    <textarea asp-for="MedicalNotes" class="thrive-textarea" placeholder="Please state any previous injuries, pregnancies or clinical conditions so your instructor can prepare modifications…"></textarea>
                </div>
            }
            else
            {
                <div class="thrive-field">
                    <label class="thrive-label" asp-for="FullName"></label>
                    <input asp-for="FullName" class="thrive-input" readonly />
                </div>

                <div class="thrive-field">
                    <label class="thrive-label" asp-for="PhoneNumber"></label>
                    <input asp-for="PhoneNumber" class="thrive-input" readonly />
                </div>
            }

            <div class="thrive-field">
                <label class="thrive-label" asp-for="PaymentType">Payment Plan</label>
                <select asp-for="PaymentType" class="thrive-select">
                    <option value="">-- Select Payment Plan --</option>
                    <option value="per-class">Per-class (R120)</option>
                    <option value="monthly">Monthly (R450)</option>
                </select>
                <span asp-validation-for="PaymentType" class="thrive-field-error"></span>
            </div>

            <div class="thrive-field">
                <label class="thrive-label" asp-for="Method">Payment Method</label>
                <select asp-for="Method" class="thrive-select">
                    <option value="">-- Select Payment Method --</option>
                    <option value="EFT">EFT</option>
                    <option value="cash">Cash</option>
                </select>
                <span asp-validation-for="Method" class="thrive-field-error"></span>
            </div>

            @if (Model.IsNewClient)
            {
                <div class="thrive-checkbox-row thrive-field">
                    <input asp-for="ConsentSigned" type="checkbox" id="consentSigned" />
                    <label for="consentSigned">
                        I confirm that I have read and agree to the indemnity terms and class policies.
                        <br />
                        <a asp-controller="Home" asp-action="Policy">View full policy</a>
                    </label>
                </div>
                <span asp-validation-for="ConsentSigned" class="thrive-field-error"></span>
            }

            <button type="submit" class="thrive-btn thrive-btn--rose thrive-btn--block">Continue to Booking</button>
        </form>
    </div>
</section>
