@model ThriveWellness.Models.BookingConfirmationViewModel

@{
    ViewData["Title"] = "Booking Received";
    ViewData["ThriveBodyBeige"] = true;
    var isEft = string.Equals(Model.Method, "EFT", StringComparison.OrdinalIgnoreCase);
    var isCard = PaymentMethods.IsCard(Model.Method);
    var isPaid = Model.PaymentStatus == PaymentStatuses.Confirmed;
    var canPayByCard = isCard && Model.PaymentStatus == PaymentStatuses.Pending && Model.Status != "Cancelled";
    var amountText = Model.AmountDue.HasValue ? $"R{Model.AmountDue.Value}" : "the class fee";
}

<section class="thrive-container thrive-booking-page">
    <div class="thrive-booking-card">
        <div class="thrive-booking-card__header">
            <div class="thrive-result-icon"><partial name="_Icon" model="@("clock")" /></div>
            <h1 class="thrive-h2-heading">Booking received</h1>
            <span class="thrive-subtitle-italic">Your spot is being held for you pending payment.</span>
        </div>

        <div class="thrive-detail-card">
            <div class="thrive-detail-row">
                <span class="thrive-detail-row__label"><partial name="_Icon" model="@("people")" />Session Type</span>
                <span class="thrive-detail-row__value">@Model.SessionType.ToDisplayLabel()</span>
            </div>
            <div class="thrive-detail-row">
                <span class="thrive-detail-row__label"><partial name="_Icon" model="@("calendar")" />Date &amp; Time</span>
                <span class="thrive-detail-row__value">@Model.SessionDate.ToString("dddd, d MMMM yyyy") | @Model.SessionTime.ToString(@"hh\:mm")</span>
            </div>
            <div class="thrive-detail-row">
                <span class="thrive-detail-row__label"><partial name="_Icon" model="@("pin")" />Location</span>
                <span class="thrive-detail-row__value">@Model.LocationAddress Studio</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.Method))
            {
                <div class="thrive-detail-row">
                    <span class="thrive-detail-row__label"><partial name="_Icon" model="@("card")" />Payment Method</span>
                    <span class="thrive-detail-row__value">@Model.Method</span>
                </div>
            }
            @if (Model.AmountDue.HasValue)
            {
                <div class="thrive-detail-row">
                    <span class="thrive-detail-row__label"><partial name="_Icon" model="@("tag")" />Amount Due</span>
                    <span class="thrive-detail-row__value">R@(Model.AmountDue.Value)</span>
                </div>
            }
        </div>

        @* What the client has to do next depends on how they chose to pay -
           nothing is paid yet, so this page never calls the booking
           confirmed. *@
        @if (isCard && isPaid)
        {
            <p class="thrive-booking-caption">
                <strong>Paid:</strong> your card payment went through and you're booked in.
            </p>

            <a class="thrive-btn thrive-btn--rose thrive-btn--block" asp-controller="Checkout" asp-action="Receipt" asp-route-paymentId="@Model.PaymentId">View receipt</a>
        }
        else if (isCard)
        {
            <p class="thrive-booking-caption">
                <strong>Next step:</strong>
                pay @amountText securely by card to confirm your spot. If you close this page, you can pay later from your dashboard.
            </p>

            @if (canPayByCard)
            {
                <a class="thrive-btn thrive-btn--rose thrive-btn--block" asp-controller="Checkout" asp-action="Pay" asp-route-bookingId="@Model.BookingId">Pay now</a>
            }
        }
        else
        {
            <p class="thrive-booking-caption">
                <strong>Next step:</strong>
                @if (isEft)
                {
                    <text>pay @amountText by EFT using the banking details in the email we've just sent you, with your name and booking number (@Model.BookingId) as the reference.</text>
                }
                else
                {
                    <text>bring @amountText in cash and pay at the studio before your class starts.</text>
                }
                We'll email you again once the studio has received your payment.
            </p>
        }

        <a class="thrive-btn thrive-btn--mauve thrive-btn--block" asp-controller="Booking" asp-action="Schedule">Back to Schedule</a>

        <p class="thrive-booking-caption">
            Need to cancel?
            <a asp-controller="Booking" asp-action="Cancel" asp-route-token="@Model.CancellationToken">Cancel this booking</a>
        </p>
    </div>
</section>
