@model ThriveWellness.Models.ScheduleViewModel

@{
    ViewData["Title"] = "Weekly Class Schedule";
    var dateValue = Model.SelectedDate?.ToString("yyyy-MM-dd");
    var weekValue = Model.Week.Start.ToString("yyyy-MM-dd");
}

<section class="thrive-container">
    <h1 class="thrive-h2-serif-italic">Weekly Class Schedule</h1>

    @* Week browsing: Previous/Next are clamped by ScheduleWeek (no past
       weeks, nothing after the last scheduled session), so a missing
       target renders as a disabled button rather than a dead link. Moving
       week keeps the location filter but drops a picked date, since that
       date belongs to the week being left. *@
    <nav class="thrive-week-nav" aria-label="Choose a week">
        @if (Model.Week.PreviousStart is DateTime previous)
        {
            <a class="thrive-btn thrive-btn--outline thrive-btn--sm" asp-action="Schedule" asp-route-location="@Model.SelectedLocation" asp-route-week="@previous.ToString("yyyy-MM-dd")">&larr; Previous</a>
        }
        else
        {
            <span class="thrive-btn thrive-btn--outline thrive-btn--sm thrive-week-nav__disabled" aria-disabled="true">&larr; Previous</span>
        }

        <div class="thrive-week-nav__range">
            <span class="thrive-week-nav__label">@Model.Week.RangeLabel()</span>
            @if (Model.Week.IsThisWeek)
            {
                <span class="thrive-week-nav__today">This week</span>
            }
            else
            {
                <a class="thrive-week-nav__today" asp-action="Schedule" asp-route-location="@Model.SelectedLocation">Back to this week</a>
            }
        </div>

        @if (Model.Week.NextStart is DateTime next)
        {
            <a class="thrive-btn thrive-btn--outline thrive-btn--sm" asp-action="Schedule" asp-route-location="@Model.SelectedLocation" asp-route-week="@next.ToString("yyyy-MM-dd")">Next &rarr;</a>
        }
        else
        {
            <span class="thrive-btn thrive-btn--outline thrive-btn--sm thrive-week-nav__disabled" aria-disabled="true">Next &rarr;</span>
        }
    </nav>

    <div class="thrive-schedule-toolbar">
        <ul class="thrive-tabs">
            <li>
                <a class="thrive-tabs__link @(string.IsNullOrEmpty(Model.SelectedLocation) ? "thrive-tabs__link--active" : "")"
                   aria-current="@(string.IsNullOrEmpty(Model.SelectedLocation) ? "true" : null)"
                   asp-action="Schedule" asp-route-location="" asp-route-date="@dateValue" asp-route-week="@weekValue">All Locations</a>
            </li>
            @foreach (var location in Model.Locations)
            {
                <li>
                    <a class="thrive-tabs__link @(Model.SelectedLocation == location.Address ? "thrive-tabs__link--active" : "")"
                       aria-current="@(Model.SelectedLocation == location.Address ? "true" : null)"
                       asp-action="Schedule" asp-route-location="@location.Address" asp-route-date="@dateValue" asp-route-week="@weekValue">@location.Address</a>
                </li>
            }
        </ul>

        <form method="get" asp-action="Schedule" class="thrive-date-filter" data-auto-submit="true">
            <input type="hidden" name="location" value="@Model.SelectedLocation" />
            <label class="thrive-visually-hidden" for="scheduleDate">Filter by date</label>
            <partial name="_Icon" model="@("calendar")" />
            <input type="date" id="scheduleDate" name="date" class="thrive-input" value="@dateValue" />
            <button type="submit" class="thrive-btn thrive-btn--outline">Filter</button>
            @if (Model.SelectedDate.HasValue)
            {
                <a class="thrive-date-filter__clear" asp-action="Schedule" asp-route-location="@Model.SelectedLocation" asp-route-week="@weekValue">Clear date</a>
            }
        </form>
    </div>

    @if (!Model.Sessions.Any())
    {
        <div class="thrive-empty-state">
            @if (Model.SelectedDate.HasValue)
            {
                <p class="thrive-h3-serif-italic">No classes on this day</p>
                <p>Try another day or location, or clear the date to see the whole week.</p>
            }
            else
            {
                <p class="thrive-h3-serif-italic">No classes this week</p>
                <p>
                    Nothing is scheduled here for @Model.Week.RangeLabel() yet.
                    @if (Model.Week.NextStart is DateTime nextWeek)
                    {
                        <a asp-action="Schedule" asp-route-location="@Model.SelectedLocation" asp-route-week="@nextWeek.ToString("yyyy-MM-dd")">Have a look at next week</a><text>, try another location, or check back soon for new classes.</text>
                    }
                    else
                    {
                        <text>Try another location, or check back soon for new classes.</text>
                    }
                </p>
            }
        </div>
    }
    else
    {
        <div class="thrive-schedule-grid">
            @foreach (var session in Model.Sessions)
            {
                <div class="thrive-session-card">
                    <div class="thrive-session-card__header">
                        <span class="thrive-pill thrive-pill--outline">@session.SessionType.ToUpperInvariant()</span>
                        <span class="thrive-pill">@session.LocationAddress</span>
                    </div>

                    <h2 class="thrive-session-card__date">@session.Date.ToString("dddd • d MMMM yyyy")</h2>
                    <p class="thrive-session-card__time">at @session.Time.ToString(@"hh\:mm")</p>

                    @if (session.IsFull)
                    {
                        <p class="thrive-session-card__full">
                            <partial name="_Icon" model="@("x")" />
                            Fully Booked
                        </p>
                        <a class="thrive-btn thrive-btn--muted thrive-btn--block" asp-action="JoinWaitlist" asp-route-sessionId="@session.SessionId">Join Waitlist</a>
                    }
                    else if (session.IsLowAvailability)
                    {
                        <p class="thrive-session-card__spots thrive-session-card__spots--low">
                            <partial name="_Icon" model="@("alert-circle")" />
                            @session.AvailableSpots spot@(session.AvailableSpots == 1 ? "" : "s") remaining
                        </p>
                        <a class="thrive-btn thrive-btn--maroon thrive-btn--block" asp-action="Book" asp-route-sessionId="@session.SessionId">Book Now</a>
                    }
                    else
                    {
                        <p class="thrive-session-card__spots thrive-session-card__spots--available">
                            <partial name="_Icon" model="@("check-circle")" />
                            Spots available
                        </p>
                        <a class="thrive-btn thrive-btn--maroon thrive-btn--block" asp-action="Book" asp-route-sessionId="@session.SessionId">Book Now</a>
                    }
                </div>
            }
        </div>
    }
</section>
