@model ThriveWellness.Models.CancelBookingResult

@{
    ViewData["Title"] = "Cancel Booking";
    ViewData["ThriveBodyBeige"] = true;
}

<section class="thrive-container thrive-booking-page">
    <div class="thrive-booking-card">
        <div class="thrive-booking-card__header">
            @if (Model.Success)
            {
                <div class="thrive-result-icon"><partial name="_Icon" model="@("check-circle")" /></div>
                <h1 class="thrive-h2-heading">Booking Cancelled</h1>
                <span class="thrive-subtitle-italic">Your booking has been cancelled. We hope to see you again soon.</span>
            }
            else
            {
                <div class="thrive-result-icon thrive-result-icon--error"><partial name="_Icon" model="@("x")" /></div>
                <h1 class="thrive-h2-heading">We couldn't cancel that booking</h1>
                <span class="thrive-subtitle-italic">@Model.ErrorMessage</span>
            }
        </div>

        @if (Model.Success && Model.Refund.Outcome == RefundOutcome.CardRefunded)
        {
            <div class="thrive-banner thrive-banner--success" role="status">
                Your card payment of @Money.Format(Model.Refund.Amount) will be refunded.
            </div>
        }
        else if (Model.Success && Model.Refund.Outcome == RefundOutcome.RefundDue)
        {
            <div class="thrive-banner thrive-banner--notice" role="status">
                You paid @Money.Format(Model.Refund.Amount) by EFT or cash. The studio will arrange your refund.
            </div>
        }

        @if (User.IsClient())
        {
            <a class="thrive-btn thrive-btn--rose thrive-btn--block thrive-cancel-keep" asp-controller="Account" asp-action="Dashboard">Go to my dashboard</a>
        }
        <a class="thrive-btn thrive-btn--mauve thrive-btn--block thrive-cancel-keep" asp-controller="Booking" asp-action="Schedule">Back to Schedule</a>
    </div>
</section>
