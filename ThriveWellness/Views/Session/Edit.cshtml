@model ThriveWellness.Models.SessionFormViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit Session";
    Layout = "_AdminLayout";
}

<div class="thrive-admin-page-header">
    <h1>Edit Session</h1>
</div>

<div class="thrive-admin-card thrive-admin-card--form">
    <div asp-validation-summary="All" class="thrive-validation-summary"></div>

    <form asp-action="Edit" asp-route-id="@Model.SessionId" method="post" data-busy-text="Saving…">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SessionId" />

        <div class="thrive-field">
            <label class="thrive-label" asp-for="LocationId"></label>
            <select asp-for="LocationId" class="thrive-select" asp-items="@(new SelectList(Model.Locations, "LocationId", "Name"))">
                <option value="">-- Select Location --</option>
            </select>
            <span asp-validation-for="LocationId" class="thrive-field-error"></span>
        </div>

        <div class="thrive-field">
            <label class="thrive-label" asp-for="SessionType"></label>
            <select asp-for="SessionType" class="thrive-select">
                <option value="">-- Select Type --</option>
                <option value="group">Group</option>
                <option value="private">Private</option>
            </select>
            <span asp-validation-for="SessionType" class="thrive-field-error"></span>
        </div>

        <div class="thrive-field">
            <label class="thrive-label" asp-for="Date"></label>
            <input asp-for="Date" class="thrive-input" />
            <span asp-validation-for="Date" class="thrive-field-error"></span>
        </div>

        <div class="thrive-field">
            <label class="thrive-label" asp-for="Time"></label>
            <input asp-for="Time" class="thrive-input" />
            <span asp-validation-for="Time" class="thrive-field-error"></span>
        </div>

        <div class="thrive-field">
            <label class="thrive-label" asp-for="Capacity"></label>
            <input asp-for="Capacity" class="thrive-input" />
            <span asp-validation-for="Capacity" class="thrive-field-error"></span>
        </div>

        <div class="thrive-checkbox-row thrive-field">
            <input asp-for="IsOpen" type="checkbox" id="isOpen" />
            <label for="isOpen">Open for bookings</label>
        </div>

        <div class="thrive-admin-form-actions">
            <button type="submit" class="thrive-btn thrive-btn--mauve">Save</button>
            <a class="thrive-btn thrive-btn--outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
