@model IEnumerable<ThriveWellness.Models.PaymentOverviewViewModel>

@{
    ViewData["Title"] = "Payments";
    Layout = "_AdminLayout";
    var selectedStatus = (string)ViewData["SelectedStatus"]!;
}

<div class="thrive-admin-page-header">
    <h1>Payments</h1>
    <span class="thrive-admin-page-header__subtitle">Manage client payment confirmations.</span>
</div>

<div class="thrive-admin-filter-tabs">
    <a class="thrive-admin-filter-tab @(selectedStatus == "all" ? "thrive-admin-filter-tab--active" : "")" asp-action="Index" asp-route-status="all">All</a>
    <a class="thrive-admin-filter-tab @(selectedStatus == "Pending" ? "thrive-admin-filter-tab--active" : "")" asp-action="Index" asp-route-status="Pending">Pending</a>
    <a class="thrive-admin-filter-tab @(selectedStatus == "Confirmed" ? "thrive-admin-filter-tab--active" : "")" asp-action="Index" asp-route-status="Confirmed">Confirmed</a>
    <a class="thrive-admin-filter-tab @(selectedStatus == PaymentStatuses.RefundDue ? "thrive-admin-filter-tab--active" : "")" asp-action="Index" asp-route-status="@PaymentStatuses.RefundDue">Refund due</a>
    <a class="thrive-admin-filter-tab @(selectedStatus == PaymentStatuses.Refunded ? "thrive-admin-filter-tab--active" : "")" asp-action="Index" asp-route-status="@PaymentStatuses.Refunded">Refunded</a>
</div>

<div class="thrive-admin-card">
    @if (!Model.Any())
    {
        <p class="thrive-admin-empty">No payments to show here.</p>
    }
    else
    {
        <div class="thrive-admin-table-wrap">
            <table class="thrive-admin-table">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Session</th>
                        <th>Date</th>
                        <th>Method</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td>@payment.ClientName</td>
                            <td>
                                @payment.SessionType.ToDisplayLabel()
                                <br />
                                <span class="thrive-admin-table__muted">@payment.LocationName</span>
                            </td>
                            <td>
                                @payment.SessionDate.ToString("d MMM yyyy")
                                <br />
                                <span class="thrive-admin-table__muted">@payment.SessionTime.ToString(@"hh\:mm")</span>
                            </td>
                            <td>
                                @payment.Method
                                @if (!string.IsNullOrEmpty(payment.GatewayReference))
                                {
                                    <br />
                                    <span class="thrive-admin-table__muted">@payment.GatewayReference</span>
                                }
                            </td>
                            <td class="thrive-admin-table__amount">R@(payment.Amount.ToString("N2"))</td>
                            <td>
                                <span class="thrive-pill @(payment.Status switch
                                {
                                    "Confirmed" => "thrive-pill--confirmed",
                                    PaymentStatuses.RefundDue => "thrive-pill--refund-due",
                                    PaymentStatuses.Refunded => "thrive-pill--refunded",
                                    _ => "thrive-pill--pending"
                                })">@payment.Status</span>
                                @if (payment.BookingStatus == "Cancelled")
                                {
                                    <br />
                                    <span class="thrive-pill thrive-pill--cancelled">Booking cancelled</span>
                                }
                            </td>
                            <td>
                                @if (payment.Status == "Confirmed")
                                {
                                    <span class="thrive-admin-table__muted">Paid</span>
                                }
                                else if (payment.Status == PaymentStatuses.RefundDue)
                                {
                                    <span class="thrive-admin-table__muted">Refund the client by EFT or cash</span>
                                }
                                else if (payment.Status == PaymentStatuses.Refunded)
                                {
                                    <span class="thrive-admin-table__muted">Refunded to card</span>
                                }
                                else if (payment.BookingStatus == "Cancelled")
                                {
                                    @* Confirming would flip a cancelled booking
                                       back to Confirmed, so it isn't offered. *@
                                    <span class="thrive-admin-table__muted">Nothing to collect</span>
                                }
                                else if (PaymentMethods.IsCard(payment.Method))
                                {
                                    @* Card payments confirm themselves when the
                                       charge succeeds; there's nothing for the
                                       studio to check by hand. *@
                                    <span class="thrive-admin-table__muted">Awaiting card payment</span>
                                }
                                else
                                {
                                    <form asp-action="Confirm" asp-route-id="@payment.PaymentId" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="status" value="@selectedStatus" />
                                        <button type="submit" class="thrive-btn thrive-btn--mauve">Confirm</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
