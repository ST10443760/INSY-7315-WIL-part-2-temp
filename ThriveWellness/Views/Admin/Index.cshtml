@model ThriveWellness.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="thrive-admin-page-header">
    <h1>Welcome back, @(User.Identity?.Name ?? "Admin")!</h1>
    <span class="thrive-admin-page-header__subtitle">Here's what's happening at Thrive Pilates.</span>
</div>

<div class="thrive-admin-stats">
    <div class="thrive-admin-stat-card">
        <div class="thrive-admin-stat-card__icon"><partial name="_Icon" model="@("calendar")" /></div>
        <p class="thrive-admin-stat-card__number">@Model.UpcomingBookingsCount</p>
        <p class="thrive-admin-stat-card__label">Upcoming Bookings</p>
    </div>
    <div class="thrive-admin-stat-card">
        <div class="thrive-admin-stat-card__icon"><partial name="_Icon" model="@("card")" /></div>
        <p class="thrive-admin-stat-card__number">@Model.PendingPaymentsCount</p>
        <p class="thrive-admin-stat-card__label">Pending Payments</p>
    </div>
    <div class="thrive-admin-stat-card">
        <div class="thrive-admin-stat-card__icon"><partial name="_Icon" model="@("user-plus")" /></div>
        <p class="thrive-admin-stat-card__number">@Model.NewClientCount</p>
        <p class="thrive-admin-stat-card__label">New Clients</p>
    </div>
    <div class="thrive-admin-stat-card">
        <div class="thrive-admin-stat-card__icon"><partial name="_Icon" model="@("people")" /></div>
        <p class="thrive-admin-stat-card__number">@Model.ReturningClientCount</p>
        <p class="thrive-admin-stat-card__label">Returning Clients</p>
    </div>
</div>

<h2 class="thrive-admin-section-heading">Pending Payments</h2>

<div class="thrive-admin-card">
    @if (!Model.PendingPaymentsPreview.Any())
    {
        <p class="thrive-admin-empty">No payments are currently pending.</p>
    }
    else
    {
        <div class="thrive-admin-table-wrap">
            <table class="thrive-admin-table">
                <thead>
                    <tr>
                        <th>Client Name</th>
                        <th>Session</th>
                        <th>Date</th>
                        <th>Payment Method</th>
                        <th>Amount</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.PendingPaymentsPreview)
                    {
                        <tr>
                            <td>@payment.ClientName</td>
                            <td>
                                @payment.SessionType.ToDisplayLabel()
                                <br />
                                <span class="thrive-admin-table__muted">@payment.LocationName</span>
                            </td>
                            <td>
                                @payment.SessionDate.ToString("d MMM yyyy")
                                <br />
                                <span class="thrive-admin-table__muted">@payment.SessionTime.ToString(@"hh\:mm")</span>
                            </td>
                            <td>@payment.Method</td>
                            <td class="thrive-admin-table__amount">R@(payment.Amount.ToString("N2"))</td>
                            <td>
                                <form asp-controller="Payment" asp-action="Confirm" asp-route-id="@payment.PaymentId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="thrive-btn thrive-btn--mauve">Confirm</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <a class="thrive-admin-link" asp-controller="Payment" asp-action="Index" asp-route-status="Pending">View all pending payments &rarr;</a>
    }
</div>

<h2 class="thrive-admin-section-heading">Upcoming Sessions</h2>

<div class="thrive-admin-card">
    @if (!Model.UpcomingSessions.Any())
    {
        <p class="thrive-admin-empty">No sessions scheduled in the next 7 days.</p>
    }
    else
    {
        <div class="thrive-admin-table-wrap">
            <table class="thrive-admin-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Bookings</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model.UpcomingSessions)
                    {
                        <tr>
                            <td>@session.Date.ToString("ddd d MMM yyyy")</td>
                            <td>@session.Time.ToString(@"hh\:mm")</td>
                            <td>
                                <span class="thrive-pill @(session.SessionType == "private" ? "thrive-pill--private" : "")">@session.SessionType.ToDisplayLabel()</span>
                            </td>
                            <td>@session.LocationName</td>
                            <td class="@(session.IsFull ? "thrive-admin-table__amount" : "")">@session.BookedCount/@session.Capacity</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<h2 class="thrive-admin-section-heading">Recent Bookings</h2>

<div class="thrive-admin-card">
    @if (!Model.RecentBookings.Any())
    {
        <p class="thrive-admin-empty">No bookings yet.</p>
    }
    else
    {
        <div class="thrive-admin-table-wrap">
            <table class="thrive-admin-table">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Session</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.RecentBookings)
                    {
                        var statusPill = booking.Status switch
                        {
                            "Confirmed" => "thrive-pill--confirmed",
                            "Cancelled" => "thrive-pill--cancelled",
                            "Awaiting Payment" => "thrive-pill--pending",
                            _ => "thrive-pill--pending"
                        };
                        <tr>
                            <td>@booking.ClientName</td>
                            <td>
                                @booking.SessionType.ToDisplayLabel()
                                <br />
                                <span class="thrive-admin-table__muted">@booking.LocationName</span>
                            </td>
                            <td>@booking.SessionDate.ToString("d MMM yyyy")</td>
                            <td><span class="thrive-pill @statusPill">@booking.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
