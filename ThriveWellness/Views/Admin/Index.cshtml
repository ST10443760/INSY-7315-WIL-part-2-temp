@model ThriveWellness.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-subtitle text-muted">Pending payments</h6>
                <p class="display-6 mb-1">@Model.PendingPaymentsCount</p>
                <a asp-controller="Payment" asp-action="Pending">Review and confirm</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-subtitle text-muted">Clients: new / returning</h6>
                <p class="display-6 mb-1">@Model.NewClientCount / @Model.ReturningClientCount</p>
                <span class="text-muted">@(Model.NewClientCount + Model.ReturningClientCount) total</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-subtitle text-muted">Clients on a waitlist</h6>
                <p class="display-6 mb-1">@Model.WaitlistedClientCount</p>
                <a asp-controller="Admin" asp-action="Waitlist">View waitlists</a>
            </div>
        </div>
    </div>
</div>

<h2>Upcoming sessions (next 7 days)</h2>

@if (!Model.UpcomingSessions.Any())
{
    <p>No sessions scheduled in the next 7 days.</p>
}
else
{
    <table class="table table-bordered table-sm">
        <thead>
            <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Type</th>
                <th>Location</th>
                <th>Booked</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var session in Model.UpcomingSessions)
            {
                <tr>
                    <td>@session.Date.ToString("yyyy-MM-dd")</td>
                    <td>@session.Time.ToString(@"hh\:mm")</td>
                    <td>@session.SessionType</td>
                    <td>@session.LocationName</td>
                    <td>@session.BookedCount / @session.Capacity</td>
                    <td>@(session.IsOpen ? "Open" : "Full")</td>
                    <td><a asp-controller="Session" asp-action="Waitlist" asp-route-id="@session.SessionId">Waitlist</a></td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Recent bookings</h2>

@if (!Model.RecentBookings.Any())
{
    <p>No bookings yet.</p>
}
else
{
    <table class="table table-bordered table-sm">
        <thead>
            <tr>
                <th>Booked on</th>
                <th>Client</th>
                <th>Session</th>
                <th>Session date</th>
                <th>Location</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.RecentBookings)
            {
                <tr>
                    <td>@booking.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@booking.ClientName</td>
                    <td>@booking.SessionType</td>
                    <td>@booking.SessionDate.ToString("yyyy-MM-dd")</td>
                    <td>@booking.LocationName</td>
                    <td>@booking.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
