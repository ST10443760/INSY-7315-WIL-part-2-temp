@using System.Globalization
@model ThriveWellness.Models.RevenueReport

@{
    ViewData["Title"] = "Revenue";
    Layout = "_AdminLayout";
    var range = Model.Range;
    var fromValue = range.From?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var toValue = range.To?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var rangeLabel = range.Preset switch
    {
        RevenuePreset.ThisMonth => "This month",
        RevenuePreset.Last30Days => "Last 30 days",
        RevenuePreset.ThisYear => "This year",
        RevenuePreset.Custom => $"{range.From?.ToString("d MMM yyyy") ?? "The start"} to {range.To?.ToString("d MMM yyyy") ?? "today"}",
        _ => "All time"
    };
    string Share(decimal share) => $"{Math.Round(share * 100, 1).ToString("0.#", CultureInfo.InvariantCulture)}%";

    // The same range on the CSV link (and the graph toggle) as on the page.
    var csvRoute = new Dictionary<string, string?>
    {
        ["preset"] = range.Preset switch { RevenuePreset.ThisMonth => "month", RevenuePreset.Last30Days => "30days", RevenuePreset.ThisYear => "year", _ => null },
        ["from"] = range.Preset == RevenuePreset.Custom ? fromValue : null,
        ["to"] = range.Preset == RevenuePreset.Custom ? toValue : null
    };

    // The graph's grouping travels with the range links and the date form,
    // and the toggle keeps the range.
    var monthly = Model.Grouping == RevenueGrouping.Monthly;
    var group = monthly ? "monthly" : null;
    var weeklyRoute = new Dictionary<string, string?>(csvRoute);
    var monthlyRoute = new Dictionary<string, string?>(csvRoute) { ["group"] = "monthly" };

    var series = Model.Series;
    var period = monthly ? "month" : "week";
    var highest = series.Count == 0 ? null : series.OrderByDescending(p => p.Amount).First();
    var chartLabel = highest == null
        ? $"Net revenue by {period}, {rangeLabel}: nothing paid."
        : $"Net revenue by {period}, {rangeLabel}: total {Money.Format(series.Sum(p => p.Amount))} over {series.Count} {period}{(series.Count == 1 ? "" : "s")}; highest {highest.LongLabel} at {Money.Format(highest.Amount)}.";
}

<div class="thrive-admin-page-header">
    <h1>Revenue</h1>
    <span class="thrive-admin-page-header__subtitle">Money received from clients: @rangeLabel.</span>
</div>

<div class="thrive-admin-filter-tabs">
    <a class="thrive-admin-filter-tab @(range.Preset == RevenuePreset.ThisMonth ? "thrive-admin-filter-tab--active" : "")" asp-action="Revenue" asp-route-preset="month" asp-route-group="@group">This month</a>
    <a class="thrive-admin-filter-tab @(range.Preset == RevenuePreset.Last30Days ? "thrive-admin-filter-tab--active" : "")" asp-action="Revenue" asp-route-preset="30days" asp-route-group="@group">Last 30 days</a>
    <a class="thrive-admin-filter-tab @(range.Preset == RevenuePreset.ThisYear ? "thrive-admin-filter-tab--active" : "")" asp-action="Revenue" asp-route-preset="year" asp-route-group="@group">This year</a>
    <a class="thrive-admin-filter-tab @(range.Preset == RevenuePreset.AllTime ? "thrive-admin-filter-tab--active" : "")" asp-action="Revenue" asp-route-preset="all" asp-route-group="@group">All time</a>
</div>

<form method="get" asp-action="Revenue" class="thrive-revenue-range">
    <div class="thrive-field">
        <label class="thrive-label" for="revenueFrom">From</label>
        <input type="date" id="revenueFrom" name="from" class="thrive-input" value="@(range.Preset == RevenuePreset.Custom ? fromValue : null)" />
    </div>
    <div class="thrive-field">
        <label class="thrive-label" for="revenueTo">To</label>
        <input type="date" id="revenueTo" name="to" class="thrive-input" value="@(range.Preset == RevenuePreset.Custom ? toValue : null)" />
    </div>
    @if (monthly)
    {
        <input type="hidden" name="group" value="monthly" />
    }
    <button type="submit" class="thrive-btn thrive-btn--mauve">Apply dates</button>
</form>

<div class="thrive-admin-stats">
    <div class="thrive-admin-stat-card">
        <div class="thrive-admin-stat-card__icon"><partial name="_Icon" model="@("tag")" /></div>
        <p class="thrive-admin-stat-card__number">@Money.Format(Model.NetRevenue)</p>
        <p class="thrive-admin-stat-card__label">Net revenue</p>
    </div>
    <div class="thrive-admin-stat-card">
        <div class="thrive-admin-stat-card__icon"><partial name="_Icon" model="@("check-circle")" /></div>
        <p class="thrive-admin-stat-card__number">@Model.PaidCount</p>
        <p class="thrive-admin-stat-card__label">Paid payments</p>
    </div>
    <div class="thrive-admin-stat-card">
        <div class="thrive-admin-stat-card__icon"><partial name="_Icon" model="@("activity")" /></div>
        <p class="thrive-admin-stat-card__number">@Money.Format(Model.AveragePerPayment)</p>
        <p class="thrive-admin-stat-card__label">Average per payment</p>
    </div>
    <div class="thrive-admin-stat-card">
        <div class="thrive-admin-stat-card__icon"><partial name="_Icon" model="@("card")" /></div>
        <p class="thrive-admin-stat-card__number">@Money.Format(Model.TotalRefunded)</p>
        <p class="thrive-admin-stat-card__label">Refunded (@Model.RefundedCount)</p>
    </div>
</div>

<p class="thrive-revenue-note">
    Net revenue counts paid payments only. Refunded payments are shown separately and are not included;
    payments that are awaiting payment or due a refund are left out. Dates are class dates.
</p>

<div class="thrive-chart-header">
    <h2 class="thrive-admin-section-heading">Net revenue over time</h2>
    <div class="thrive-chart-toggle" role="group" aria-label="Group the graph by">
        <a class="thrive-chart-toggle__option @(!monthly ? "thrive-chart-toggle__option--active" : "")" aria-current="@(!monthly ? "true" : null)" asp-action="Revenue" asp-all-route-data="weeklyRoute">Weekly</a>
        <a class="thrive-chart-toggle__option @(monthly ? "thrive-chart-toggle__option--active" : "")" aria-current="@(monthly ? "true" : null)" asp-action="Revenue" asp-all-route-data="monthlyRoute">Monthly</a>
    </div>
</div>

<div class="thrive-admin-card thrive-chart" data-chart>
    @if (series.Count == 0)
    {
        <p class="thrive-admin-empty">No paid payments in this range yet, so there's nothing to graph. Try a wider date range.</p>
    }
    else
    {
        @* Drawn twice at different sizes; CSS shows the one that suits the
           screen so the text never shrinks too small to read. *@
        <partial name="_RevenueChart" model="@((RevenueChart.Build(series, 800, 300, 8), "wide", chartLabel))" />
        <partial name="_RevenueChart" model="@((RevenueChart.Build(series, 340, 240, 4), "narrow", chartLabel))" />
        <div class="thrive-chart__tooltip" data-chart-tooltip role="status" aria-live="polite" hidden></div>
        @if (series.Count == 1)
        {
            <p class="thrive-revenue-note">Only one @period in this range has payments, so it shows as a single point.</p>
        }
    }
</div>

<h2 class="thrive-admin-section-heading">By month</h2>
<div class="thrive-admin-card">
    @if (!Model.ByMonth.Any())
    {
        <p class="thrive-admin-empty">No paid payments in this range.</p>
    }
    else
    {
        <div class="thrive-admin-table-wrap">
            <table class="thrive-admin-table thrive-revenue-table">
                <thead>
                    <tr><th>Month</th><th>Amount</th><th>Payments</th><th>Share</th></tr>
                </thead>
                <tbody>
                    @foreach (var month in Model.ByMonth)
                    {
                        <tr>
                            <td>@month.Label</td>
                            <td class="thrive-admin-table__amount">@Money.Format(month.Amount)</td>
                            <td>@month.Count</td>
                            <td>@Share(month.Share)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="thrive-revenue-breakdowns">
    @foreach (var (title, rows) in new[] { ("By payment method", Model.ByMethod), ("By payment type", Model.ByPaymentType), ("By venue", Model.ByVenue) })
    {
        <section class="thrive-admin-card">
            <h2 class="thrive-revenue-card-heading">@title</h2>
            @if (!rows.Any())
            {
                <p class="thrive-admin-empty">Nothing paid in this range.</p>
            }
            else
            {
                <table class="thrive-admin-table thrive-revenue-table">
                    <thead><tr><th></th><th>Amount</th><th>Count</th><th>Share</th></tr></thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr>
                                <td>@row.Label</td>
                                <td class="thrive-admin-table__amount">@Money.Format(row.Amount)</td>
                                <td>@row.Count</td>
                                <td>@Share(row.Share)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>

<h2 class="thrive-admin-section-heading">Spend per client</h2>

@if (Model.TopClients.Any())
{
    <div class="thrive-admin-card thrive-top-clients">
        <h3 class="thrive-revenue-card-heading">Top clients</h3>
        <ol class="thrive-top-clients__list">
            @foreach (var client in Model.TopClients)
            {
                <li>
                    <span class="thrive-top-clients__name">@client.Name</span>
                    <span class="thrive-top-clients__amount">@Money.Format(client.TotalSpent)</span>
                    <span class="thrive-admin-table__muted">@client.PaymentsCount payment@(client.PaymentsCount == 1 ? "" : "s")</span>
                </li>
            }
        </ol>
    </div>
}

<div class="thrive-admin-card">
    @if (!Model.Clients.Any())
    {
        <p class="thrive-admin-empty">No client has paid for anything in this range.</p>
    }
    else
    {
        <div class="thrive-revenue-toolbar">
            <div class="thrive-input-icon-wrap thrive-admin-search">
                <label class="thrive-visually-hidden" for="clientSpendSearch">Search clients</label>
                <partial name="_Icon" model="@("search")" />
                <input type="search" id="clientSpendSearch" class="thrive-input" placeholder="Search clients..." data-table-search="clientSpendTable" />
            </div>
            <a class="thrive-btn thrive-btn--outline" asp-action="RevenueCsv" asp-all-route-data="csvRoute">Download CSV</a>
        </div>

        <div class="thrive-admin-table-wrap">
            <table class="thrive-admin-table" id="clientSpendTable" data-sortable-table>
                <thead>
                    <tr>
                        <th aria-sort="none"><button type="button" class="thrive-sort-button" data-sort-type="text">Client</button></th>
                        <th aria-sort="none"><button type="button" class="thrive-sort-button" data-sort-type="number">Payments</button></th>
                        <th aria-sort="descending"><button type="button" class="thrive-sort-button" data-sort-type="number">Total spent</button></th>
                        <th aria-sort="none"><button type="button" class="thrive-sort-button" data-sort-type="text">Last payment</button></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.Clients)
                    {
                        <tr data-search-text="@($"{client.Name} {client.Email}".ToLowerInvariant())">
                            <td data-sort-value="@client.Name.ToLowerInvariant()">
                                @client.Name
                                <br />
                                <span class="thrive-admin-table__muted">@client.Email</span>
                            </td>
                            <td data-sort-value="@client.PaymentsCount">@client.PaymentsCount</td>
                            <td class="thrive-admin-table__amount" data-sort-value="@client.TotalSpent.ToString(CultureInfo.InvariantCulture)">@Money.Format(client.TotalSpent)</td>
                            <td data-sort-value="@client.LastPaymentDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@client.LastPaymentDate.ToString("d MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="thrive-admin-empty" id="clientSpendNoMatch" hidden>No clients match that search.</p>
    }
</div>

@section Scripts {
    <script src="~/js/revenue.js" asp-append-version="true"></script>
}
