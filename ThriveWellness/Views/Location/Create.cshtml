@model ThriveWellness.Models.LocationFormViewModel

@{
    ViewData["Title"] = "Create Location";
    Layout = "_AdminLayout";
}

<div class="thrive-admin-page-header">
    <h1>Create Location</h1>
</div>

<div class="thrive-admin-card thrive-admin-card--form">
    <div asp-validation-summary="All" class="thrive-validation-summary"></div>

    <form asp-action="Create" method="post" data-busy-text="Creating…">
        @Html.AntiForgeryToken()

        <div class="thrive-field">
            <label class="thrive-label" asp-for="Name"></label>
            <input asp-for="Name" class="thrive-input" placeholder="e.g. Katz World of Dance, Studio 2" />
            <span asp-validation-for="Name" class="thrive-field-error"></span>
        </div>

        <div class="thrive-field">
            <label class="thrive-label" asp-for="Address"></label>
            <input asp-for="Address" class="thrive-input" placeholder="e.g. Sunninghill" />
            <span asp-validation-for="Address" class="thrive-field-error"></span>
        </div>

        <div class="thrive-admin-form-actions">
            <button type="submit" class="thrive-btn thrive-btn--mauve">Create</button>
            <a class="thrive-btn thrive-btn--outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
