@{
    ViewData["Title"] = "About";
}

<section class="thrive-container">
    <div class="thrive-hero__copy thrive-hero__copy--about">
        <span class="thrive-pill thrive-pill--outline">ABOUT US</span>
        <h1 class="thrive-h2-serif-italic">Our Studio</h1>
        <p>
            Thrive Pilates is a boutique studio in Johannesburg offering bespoke, small-group and
            private Pilates instruction. Every class is designed to build strength, improve posture
            and encourage mindful, precise movement, guided by an instructor who gets to know you and
            your body over time - not a room full of strangers.
        </p>
        <p>
            We keep our classes small and our studios close to home, with two locations across
            Johannesburg so you can find the one that suits you.
        </p>
    </div>
</section>

<section class="thrive-container thrive-features">
    <div class="thrive-feature-card">
        <div class="thrive-feature-card__icon"><partial name="_Icon" model="@("pin")" /></div>
        <h2 class="thrive-h3-serif-italic">Kyalami</h2>
        <p>The Hub, Little Village</p>
    </div>
    <div class="thrive-feature-card">
        <div class="thrive-feature-card__icon"><partial name="_Icon" model="@("pin")" /></div>
        <h2 class="thrive-h3-serif-italic">Sunninghill</h2>
        <p>Katz World of Dance, Studio 2</p>
    </div>
</section>

<section class="thrive-container">
    <div class="thrive-card thrive-card--narrow">
        <h2 class="thrive-card-heading">Pricing</h2>
        <p><strong>R120</strong> per class</p>
        <p><strong>R450</strong> per month, one class a week</p>
        <p>Payment accepted by EFT or cash.</p>
    </div>
</section>
