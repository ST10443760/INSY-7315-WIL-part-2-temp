@model string
@* A badge's icon, picked by Badge.IconKey. Decorative: the badge's name is
   always shown next to it. *@
<svg class="thrive-badge__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Model)
    {
        case "star":
            <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z" />
            break;
        case "leaf":
            <path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14" /><path d="M5 19l7-7" />
            break;
        case "medal":
            <circle cx="12" cy="15" r="5" /><path d="M8.5 11L6 3h4l2 5 2-5h4l-2.5 8" /><path d="M12 13v4" />
            break;
        case "trophy":
            <path d="M8 4h8v5a4 4 0 0 1-8 0z" /><path d="M8 6H5a3 3 0 0 0 3 4" /><path d="M16 6h3a3 3 0 0 1-3 4" /><path d="M12 13v4" /><path d="M8 20h8" />
            break;
        case "flame":
            <path d="M12 21c-4 0-6-2.7-6-6 0-4 3-6 4-10 2 2 3 4 3 6 1-1 1.5-2 1.5-3 2 2 3.5 4.5 3.5 7 0 3.3-2 6-6 6z" />
            break;
        case "bolt":
            <path d="M13 2L5 14h6l-1 8 8-12h-6z" />
            break;
        case "pin":
            <path d="M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z" /><circle cx="12" cy="10" r="2" />
            break;
        case "sunrise":
            <path d="M5 17a7 7 0 0 1 14 0" /><path d="M3 21h18" /><path d="M12 4v3" /><path d="M4.9 9.9l1.4 1.4" /><path d="M19.1 9.9l-1.4 1.4" />
            break;
        default:
            <circle cx="12" cy="12" r="8" />
            break;
    }
</svg>
