@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var actionName = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var nav = HeaderNav.Build(User, controllerName, actionName);
    var account = nav.Account;
    var bodyClass = "thrive-body" + (ViewData["ThriveBodyBeige"] as bool? == true ? " thrive-body--beige" : "");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thrive Wellness Pilates</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@500;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/thrive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ThriveWellness.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@bodyClass">
    <a class="thrive-skip-link" href="#main-content">Skip to content</a>

    <header class="thrive-header">
        <div class="thrive-container thrive-header__bar">
            <partial name="_Logo" />

            <button type="button" class="thrive-nav-toggle" aria-expanded="false" aria-controls="thrive-nav-list" aria-label="Open menu">
                <span data-icon-closed>
                    <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </span>
                <span data-icon-open hidden>
                    <partial name="_Icon" model="@("x")" />
                </span>
            </button>

            <nav aria-label="Main">
                <ul class="thrive-nav__list" id="thrive-nav-list">
                    <li class="thrive-nav__close-row">
                        <button type="button" class="thrive-nav__close" id="thrive-nav-close" aria-label="Close menu">
                            <partial name="_Icon" model="@("x")" />
                        </button>
                    </li>
                    @* Who sees which link is decided in HeaderNav.Build. *@
                    @foreach (var link in nav.MainLinks)
                    {
                        <li><a class="thrive-nav__link @(link.IsActive ? "thrive-nav__link--active" : "")" aria-current="@(link.IsActive ? "page" : null)" asp-controller="@link.Controller" asp-action="@link.Action">@link.Label.ToUpperInvariant()</a></li>
                    }

                    @if (nav.SignIn != null)
                    {
                        <li class="thrive-nav__signin-item">
                            <a class="thrive-btn thrive-btn--maroon thrive-nav__signin" aria-current="@(nav.SignIn.IsActive ? "page" : null)" asp-controller="@nav.SignIn.Controller" asp-action="@nav.SignIn.Action">@nav.SignIn.Label</a>
                        </li>
                    }

                    @if (account != null)
                    {
                        @* Wide screens: a profile button that opens a small menu
                           (behaviour in thrive.js). Hidden in the mobile panel,
                           which gets the plain section below instead. *@
                        <li class="thrive-profile" data-profile-menu>
                            <button type="button" class="thrive-profile__trigger" id="thrive-profile-trigger"
                                    aria-haspopup="true" aria-expanded="false" aria-controls="thrive-profile-menu"
                                    aria-label="Account menu for @account.Name">
                                <span class="thrive-profile__avatar" aria-hidden="true">@account.Initial</span>
                                <span class="thrive-profile__first-name" aria-hidden="true">@account.FirstName</span>
                                <span class="thrive-profile__chevron" aria-hidden="true"><partial name="_Icon" model="@("chevron-down")" /></span>
                            </button>
                            <div class="thrive-profile__menu" id="thrive-profile-menu" hidden>
                                <div class="thrive-profile__who">
                                    <span class="thrive-profile__who-name">@account.Name</span>
                                    <span class="thrive-profile__who-sub">@account.Subtitle</span>
                                </div>
                                <ul class="thrive-profile__items" role="menu" aria-labelledby="thrive-profile-trigger">
                                    @foreach (var item in account.Items)
                                    {
                                        <li role="none">
                                            <a role="menuitem" class="thrive-profile__item @(item.IsActive ? "thrive-profile__item--active" : "")" aria-current="@(item.IsActive ? "page" : null)"
                                               asp-controller="@item.Controller" asp-action="@item.Action" asp-fragment="@item.Fragment">@item.Label</a>
                                        </li>
                                    }
                                    <li role="none">
                                        @* Sign out is a POST with an anti-forgery token. *@
                                        <form asp-controller="Account" asp-action="@account.SignOutAction" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" role="menuitem" class="thrive-profile__item thrive-profile__item--signout">Sign out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </li>

                        @* Narrow screens: the same links as a plain section of the
                           mobile panel, headed with the name - no nested dropdown. *@
                        <li class="thrive-nav__account">
                            <p class="thrive-nav__account-name">@account.Name</p>
                            <ul class="thrive-nav__account-links">
                                @foreach (var item in account.Items)
                                {
                                    <li><a class="thrive-nav__link @(item.IsActive ? "thrive-nav__link--active" : "")" aria-current="@(item.IsActive ? "page" : null)" asp-controller="@item.Controller" asp-action="@item.Action" asp-fragment="@item.Fragment">@item.Label.ToUpperInvariant()</a></li>
                                }
                                <li>
                                    <form asp-controller="Account" asp-action="@account.SignOutAction" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="thrive-nav__link thrive-nav__button">SIGN OUT</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </header>

    <div class="thrive-menu-backdrop" id="thrive-nav-backdrop" hidden></div>

    <main id="main-content" role="main" class="thrive-main">
        @RenderBody()
    </main>

    <footer class="thrive-footer">
        <div class="thrive-container">
            <div class="thrive-footer__grid">
                <div class="thrive-footer__brand">
                    <partial name="_Logo" />
                    <p class="thrive-footer__tagline">Boutique Pilates studio offering bespoke instruction designed to cultivate strength, precision, and mindful movement.</p>
                </div>
                <div class="thrive-footer__studio">
                    <h3>Sunninghill Studio</h3>
                    <p>Katz World of Dance, Studio 2</p>
                    <p>Sunninghill</p>
                </div>
                <div class="thrive-footer__studio">
                    <h3>Kyalami Studio</h3>
                    <p>The Hub, Little Village</p>
                    <p>Kyalami</p>
                </div>
            </div>

            <div class="thrive-footer__bottom">
                <span>&copy; 2026 Thrive Pilates. All rights reserved.</span>
                <span>
                    <a asp-controller="Home" asp-action="Policy">Class Policy</a>
                    &middot;
                    <a asp-controller="Account" asp-action="Login">Staff login</a>
                    &middot;
                    <span>@@thrive_wellness_pilates</span>
                </span>
            </div>
        </div>
    </footer>

    @* jQuery isn't loaded here: Bootstrap 5's bundle JS doesn't need it, and
       nothing on the public or admin side (confirmed by search) calls it -
       the scaffolded _ValidationScriptsPartial that references
       jquery-validation is never rendered by any view either. *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/thrive.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
