@model string
@*
    Small inline line-style icon set. Pass the icon name as the model, e.g.
    <partial name="_Icon" model="\"people\"" />
    All icons are decorative by default (aria-hidden) - where an icon is the
    only content of a button/link, wrap it and add an aria-label on the
    parent instead of trying to label the SVG itself.
*@
@switch (Model)
{
    case "people":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.7" />
            <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            <circle cx="17" cy="9" r="2.4" stroke="currentColor" stroke-width="1.7" />
            <path d="M15.5 14.2c2.6.4 4.5 2.6 4.5 5.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        break;
    case "target":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.7" />
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7" />
            <circle cx="12" cy="12" r="0.8" fill="currentColor" />
        </svg>
        break;
    case "pin":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
            <circle cx="12" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.7" />
        </svg>
        break;
    case "envelope":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="1.7" />
            <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case "calendar":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3.5" y="5" width="17" height="15" rx="2.5" stroke="currentColor" stroke-width="1.7" />
            <path d="M8 3v4M16 3v4M3.5 10h17" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        break;
    case "clock":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7" />
            <path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case "lock":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="5" y="10.5" width="14" height="9.5" rx="2.2" stroke="currentColor" stroke-width="1.7" />
            <path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" stroke="currentColor" stroke-width="1.7" />
        </svg>
        break;
    case "check":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12.5 10 17l9-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case "check-circle":
        <svg class="thrive-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <circle cx="24" cy="24" r="24" fill="currentColor" />
            <path d="M14 24.5 20.5 31 34 17" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" />
        </svg>
        break;
    case "alert-circle":
        <svg class="thrive-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <circle cx="24" cy="24" r="24" fill="currentColor" />
            <path d="M24 14v14" stroke="#fff" stroke-width="3" stroke-linecap="round" />
            <circle cx="24" cy="34" r="2.2" fill="#fff" />
        </svg>
        break;
    case "card":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="6" width="18" height="12" rx="2.2" stroke="currentColor" stroke-width="1.7" />
            <path d="M3 10h18" stroke="currentColor" stroke-width="1.7" />
        </svg>
        break;
    case "tag":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M11.6 3.5h6a2 2 0 0 1 2 2v6a2 2 0 0 1-.6 1.4l-9.3 9.3a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8l9.3-9.3a2 2 0 0 1 .6-.4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            <circle cx="16" cy="8" r="1.4" fill="currentColor" />
        </svg>
        break;
    case "x":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
        </svg>
        break;
    case "phone":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6.5 3.5h3l1.5 4-2 1.5a13 13 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2C10.8 19 5 13.2 4.5 5.7A2 2 0 0 1 6.5 3.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        </svg>
        break;
    case "grid":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3.5" y="3.5" width="7.5" height="7.5" rx="1.5" stroke="currentColor" stroke-width="1.7" />
            <rect x="13" y="3.5" width="7.5" height="7.5" rx="1.5" stroke="currentColor" stroke-width="1.7" />
            <rect x="3.5" y="13" width="7.5" height="7.5" rx="1.5" stroke="currentColor" stroke-width="1.7" />
            <rect x="13" y="13" width="7.5" height="7.5" rx="1.5" stroke="currentColor" stroke-width="1.7" />
        </svg>
        break;
    case "activity":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M2.5 12h4l2.5-7 4 14 2.5-7h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case "list":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="4.5" cy="6" r="1.3" fill="currentColor" />
            <circle cx="4.5" cy="12" r="1.3" fill="currentColor" />
            <circle cx="4.5" cy="18" r="1.3" fill="currentColor" />
            <path d="M9 6h11.5M9 12h11.5M9 18h11.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        break;
    case "logout":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M10.5 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M15.5 8.5 20 12l-4.5 3.5M20 12H9.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case "eye":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.6" />
        </svg>
        break;
    case "eye-off":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 4l16 16M9.9 9.9a2.6 2.6 0 0 0 3.7 3.7M6.2 6.5C3.9 8 2 12 2 12s3.5 6.5 10 6.5c1.8 0 3.4-.5 4.7-1.2M11 5.6c.3 0 .7-.1 1-.1 6.5 0 10 6.5 10 6.5a15 15 0 0 1-2.3 3.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case "search":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7" />
            <path d="m20 20-4.8-4.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        break;
    case "user":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.7" />
            <path d="M4.5 20c0-4.1 3.4-7.5 7.5-7.5s7.5 3.4 7.5 7.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        break;
    case "user-plus":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="9.5" cy="8" r="3.3" stroke="currentColor" stroke-width="1.7" />
            <path d="M2.5 20c0-3.9 3.1-7 7-7s7 3.1 7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            <path d="M18.5 7v6M15.5 10h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        break;
    case "edit":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 4.5 19.5 9 8 20.5H3.5V16Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            <path d="m13 6.5 4 4" stroke="currentColor" stroke-width="1.6" />
        </svg>
        break;
    case "trash":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4.5 7h15M9.5 7V5a1.5 1.5 0 0 1 1.5-1.5h2A1.5 1.5 0 0 1 14.5 5v2M18 7l-.8 12.2a2 2 0 0 1-2 1.8H8.8a2 2 0 0 1-2-1.8L6 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M10 11v6M14 11v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        break;
    case "plus":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 4.5v15M4.5 12h15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        break;
    case "chevron-down":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case "menu":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        break;
}
