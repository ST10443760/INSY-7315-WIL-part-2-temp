@model string
@*
    Small inline line-style icon set. Pass the icon name as the model, e.g.
    <partial name="_Icon" model="\"people\"" />
    All icons are decorative by default (aria-hidden) - where an icon is the
    only content of a button/link, wrap it and add an aria-label on the
    parent instead of trying to label the SVG itself.
*@
@switch (Model)
{
    case "people":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.7" />
            <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            <circle cx="17" cy="9" r="2.4" stroke="currentColor" stroke-width="1.7" />
            <path d="M15.5 14.2c2.6.4 4.5 2.6 4.5 5.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        break;
    case "target":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.7" />
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7" />
            <circle cx="12" cy="12" r="0.8" fill="currentColor" />
        </svg>
        break;
    case "pin":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
            <circle cx="12" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.7" />
        </svg>
        break;
    case "envelope":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="1.7" />
            <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case "calendar":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3.5" y="5" width="17" height="15" rx="2.5" stroke="currentColor" stroke-width="1.7" />
            <path d="M8 3v4M16 3v4M3.5 10h17" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        break;
    case "clock":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7" />
            <path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case "lock":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="5" y="10.5" width="14" height="9.5" rx="2.2" stroke="currentColor" stroke-width="1.7" />
            <path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" stroke="currentColor" stroke-width="1.7" />
        </svg>
        break;
    case "check":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12.5 10 17l9-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case "check-circle":
        <svg class="thrive-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <circle cx="24" cy="24" r="24" fill="currentColor" />
            <path d="M14 24.5 20.5 31 34 17" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" />
        </svg>
        break;
    case "alert-circle":
        <svg class="thrive-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <circle cx="24" cy="24" r="24" fill="currentColor" />
            <path d="M24 14v14" stroke="#fff" stroke-width="3" stroke-linecap="round" />
            <circle cx="24" cy="34" r="2.2" fill="#fff" />
        </svg>
        break;
    case "card":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="6" width="18" height="12" rx="2.2" stroke="currentColor" stroke-width="1.7" />
            <path d="M3 10h18" stroke="currentColor" stroke-width="1.7" />
        </svg>
        break;
    case "x":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
        </svg>
        break;
    case "phone":
        <svg class="thrive-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6.5 3.5h3l1.5 4-2 1.5a13 13 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2C10.8 19 5 13.2 4.5 5.7A2 2 0 0 1 6.5 3.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        </svg>
        break;
}
