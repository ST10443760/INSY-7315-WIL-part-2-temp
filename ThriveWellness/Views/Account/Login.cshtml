@model ThriveWellness.Models.LoginViewModel

@{
    ViewData["Title"] = "Admin Login";
    // Reached while signed out, so this deliberately keeps the public
    // header/footer (per desktop-admin-login.png) rather than the
    // sidebar shell every other admin page uses once authenticated.
    Layout = "_Layout";
}

<section class="thrive-admin-login-page">
    <div class="thrive-admin-login-card">
        <partial name="_Logo" />

        <h1 class="thrive-admin-login-card__heading">Admin Login</h1>
        <span class="thrive-admin-login-card__subtitle">Thrive Wellness Pilates Management Portal</span>

        <div asp-validation-summary="All" class="thrive-validation-summary"></div>

        <form asp-controller="Account" asp-action="Login" method="post" data-busy-text="Logging in…">
            @Html.AntiForgeryToken()

            <div class="thrive-field">
                <label class="thrive-label" asp-for="Username">Username</label>
                <div class="thrive-input-icon-wrap">
                    <partial name="_Icon" model="@("user")" />
                    <input asp-for="Username" class="thrive-input" placeholder="Enter your username" autocomplete="username" />
                </div>
                <span asp-validation-for="Username" class="thrive-field-error"></span>
            </div>

            <div class="thrive-field">
                <label class="thrive-label" asp-for="Password">Password</label>
                <div class="thrive-input-icon-wrap">
                    <partial name="_Icon" model="@("lock")" />
                    <input asp-for="Password" id="adminPassword" class="thrive-input" placeholder="Enter your password" autocomplete="current-password" />
                    <button type="button" class="thrive-password-toggle" data-password-toggle="adminPassword" aria-label="Show password">
                        <span data-icon-show><partial name="_Icon" model="@("eye")" /></span>
                        <span data-icon-hide hidden><partial name="_Icon" model="@("eye-off")" /></span>
                    </button>
                </div>
                <span asp-validation-for="Password" class="thrive-field-error"></span>
            </div>

            <button type="submit" class="thrive-btn thrive-btn--mauve thrive-btn--block">Log In</button>
        </form>
    </div>
</section>
