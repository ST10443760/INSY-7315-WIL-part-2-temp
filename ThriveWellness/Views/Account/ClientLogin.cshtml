@model ThriveWellness.Models.ClientLoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<section class="thrive-admin-login-page">
    <div class="thrive-admin-login-card">
        <partial name="_Logo" />

        <h1 class="thrive-admin-login-card__heading">Sign in</h1>
        <span class="thrive-admin-login-card__subtitle">Book and manage your Pilates classes</span>

        <p class="thrive-signin-note">
            We ask you to sign in so the studio can show you your bookings, rewards and receipts in one place.
        </p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="thrive-banner thrive-banner--error" role="alert">@Model.ErrorMessage</div>
        }

        @if (Model.GoogleAvailable)
        {
            <form asp-controller="Account" asp-action="GoogleSignIn" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="thrive-google-btn">
                    @* Google's standard multi-colour "G" mark, as their
                       sign-in branding guidelines ask for. *@
                    <svg class="thrive-google-btn__logo" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                    </svg>
                    <span>Sign in with Google</span>
                </button>
            </form>
        }
        else
        {
            <div class="thrive-banner thrive-banner--notice">
                Client sign-in isn't available right now. Please contact the studio to book a class.
            </div>
        }

        <p class="thrive-signin-admin-link">
            Studio admin? <a asp-controller="Account" asp-action="Login">Admin login</a>
        </p>
    </div>
</section>
